# ---- Required in production ----
SESSION_SECRET=change-me-to-64-random-hex-chars      # openssl rand -hex 32
DATA_KEY=change-me-to-another-64-random-hex-chars    # encrypts Aadhaar numbers. LOSING IT = LOSING THE DATA

# ---- Database ----
# Cloudflare D1 (production). Set all three to use D1; leave empty to use a local SQLite file for development.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=          # API token with permission: Account > D1 > Edit
DATABASE_FILE=./data/homestay.db   # local dev only

# ---- Login ----
MFA_REQUIRED=true              # authenticator-app (TOTP) required for everyone; free, no SMS

# ---- Seeding ----
OWNER_EMAIL=owner@yourdomain.in
# SEED_PASSWORD=  (if empty a random one is printed once)

# ---- Website -> dashboard booking API ----
WEBSITE_API_KEY=change-me
ICAL_TOKEN=change-me

# ---- Outbound mail (booking confirmations, marketing). Empty = dry-run (logged, not sent) ----
SMTP_URL=smtps://bookings%40yourdomain.in:APP_PASSWORD@smtp.gmail.com:465
MAIL_FROM="Your Homestay <bookings@yourdomain.in>"

# ---- Inbound mailbox (complaints). Empty = manual logging only ----
IMAP_HOST=imap.gmail.com
IMAP_USER=bookings@yourdomain.in
IMAP_PASSWORD=app-password

# ---- UPI refunds. Empty = simulated payouts ----
PAYOUT_PROVIDER=razorpayx
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# ---- Session policy ----
IDLE_TIMEOUT_MIN=15
ABSOLUTE_TIMEOUT_HOURS=8

# ---- Added: payments / mail / hosting ----
APP_URL=https://your-domain.example      # used in email links
APP_TIMEZONE=Asia/Kolkata
RESEND_API_KEY=                          # HTTPS mail API (use this on Cloudflare; SMTP sockets don't work on Workers)
INBOUND_EMAIL_SECRET=change-me           # for POST /api/inbound/email (Cloudflare Email Routing → complaints)
CRON_SECRET=change-me                    # for GET /api/cron/maintenance (hourly)
